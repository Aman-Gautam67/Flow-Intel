{
  "name": "[QA] HTTP (not HTTPS) egress to external host (v2)",
  "nodes": [
    {
      "id": "trigger-1",
      "name": "Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {}
    },
    {
      "id": "sec003-node-1",
      "name": "Call API 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ],
      "parameters": {
        "url": "https://internal-service/process",
        "method": "GET"
      },
      "continueOnFail": true,
      "onError": "continueErrorOutput"
    },
    {
      "id": "flowintel-injected-error-trigger",
      "name": "Error Trigger [Auto-Injected]",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "parameters": {
        "notes": "Auto-injected by FlowIntel remediation engine. Wire to your preferred alert channel."
      }
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Call API 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Notify On Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "flowintel-qa"
  }
}